# =============================================================================
#  .env.example — Template variabile de mediu
#  Noian Cristian · Coaching Engine · Etapa 3
#  -----------------------------------------------------------------------------
#  ACEST FIȘIER merge pe GitHub — nu conține parole reale.
#  Copiază-l și completează-l:
#    cp .env.example .env
#  Apoi editează .env cu valorile tale reale.
#
#  .env (cu valorile reale) este în .gitignore și .dockerignore — NICIODATĂ
#  nu se urcă pe GitHub sau în Docker image.
# =============================================================================


# ── Groq API ───────────────────────────────────────────────────────────────────
# Obții cheia de la: https://console.groq.com → API Keys → Create API Key
# Folosit pentru: AI Chat Coach, Food Logger (Llama 3.3 70B), Voice (Whisper)
# Cost: GRATUIT pe free tier (~14.400 req/zi, 28.800 sec audio/zi)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── PostgreSQL — Baza de Date ──────────────────────────────────────────────────
# Alege UNA dintre variantele de mai jos:

# VARIANTA 1: Neon.tech (recomandat producție)
# Obții URL-ul din: neon.tech → proiect → Connect → Connection string → asyncpg
# Format: postgresql://user:parola@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:parola@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# VARIANTA 2: Supabase (alternativă)
# Obții URL-ul din: supabase.com → proiect → Settings → Database → URI
# DATABASE_URL=postgresql://postgres:parola@db.xxx.supabase.co:5432/postgres?sslmode=require

# VARIANTA 3: PostgreSQL local (pentru docker-compose, fără internet)
# DATABASE_URL=postgresql://coaching:coaching_dev@localhost:5432/coaching_db
